DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://olokuti:change-this@127.0.0.1:5432/olokuti_digital
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@olokuti.local
EMAIL_TIMEOUT=10
PASSWORD_RESET_TIMEOUT=3600
SESSION_COOKIE_AGE=28800

# Production email settings (configure with your authorized SMTP provider)
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=no-reply@your-domain.example

# Reverse proxy & production-only values
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_TRUST_PROXY_SSL_HEADER=true
# DJANGO_TRUST_PROXY_IP_HEADER=true
# DJANGO_TRUSTED_PROXY_HOPS=1

# Optional multi-worker cache configuration for rate limiting & caching
# REDIS_URL=redis://127.0.0.1:6379/1
# DJANGO_CACHE_DIR=/tmp/olokuti_cache
